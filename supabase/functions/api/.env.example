# Secret della Edge Function "api". Copia in supabase/functions/api/.env (non va committato) e caricali con:
#   npx supabase secrets set --env-file supabase/functions/api/.env
# SUPABASE_URL e la chiave secret li inietta Supabase: non vanno impostati.

# Indirizzo pubblico del sito, usato per i link nelle email
SITE_URL=https://www.mobilityexpress.it
# Origini che possono chiamare l'API (separate da virgola), es. https://www.mobilityexpress.it
ALLOWED_ORIGINS=

# SMTP per nodemailer. Le Edge Functions non possono usare le porte 25 e 587: usare 465 con SSL.
# Se SMTP_HOST è vuoto le email vengono solo stampate nei log.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Polizze Express <stima@polizzexpress.it>"

# Destinatario delle richieste di ricontatto se il referente del link non è noto
RICONTATTO_FALLBACK_EMAIL=

# API devops a cui inoltrare la richiesta. Se vuoto le richieste vanno in errore (o simulate, vedi sotto).
EXTERNAL_API_URL=
EXTERNAL_API_TOKEN=
EXTERNAL_API_TIMEOUT_MS=15000

# Segreto condiviso con devops per chiamare POST .../functions/v1/api/devops/risultati
# (header "Authorization: Bearer <segreto>"). Generalo con: openssl rand -hex 32
DEVOPS_WEBHOOK_SECRET=

# Segreto per pg_cron (POST /interno/tentativi): lo stesso valore va nel Vault come
# prezzo_giusto_cron_secret (vedi migrazione 20261020000000). Generalo con: openssl rand -hex 32
CRON_SECRET=

# Solo in sviluppo: "true" simula devops con un range dimostrativo quando EXTERNAL_API_URL è vuoto
SIMULA_DEVOPS=
