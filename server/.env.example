# Copia in server/.env e compila. server/.env non va committato.

PORT=3001
# Indirizzo pubblico del sito, usato per i link nelle email
SITE_URL=http://localhost:5173
# Origini che possono chiamare l'API se il server è su un dominio diverso dal sito
# es. https://www.mobilityexpress.it
ALLOWED_ORIGINS=

# Supabase: Project Settings > API Keys. La chiave secret NON va mai nel frontend.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# SMTP per nodemailer. Se SMTP_HOST è vuoto le email vengono solo stampate in console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Polizze Express <stima@polizzexpress.it>"

# Destinatario delle richieste di ricontatto se il referente del link non è noto al server
RICONTATTO_FALLBACK_EMAIL=

# Chi riceve un'email per ogni nuova segnalazione dalla pagina /suggerisci/ (vuoto = solo database)
SEGNALAZIONI_EMAIL=

# API devops a cui inoltrare la richiesta. Se vuoto, in sviluppo la risposta di devops viene simulata.
EXTERNAL_API_URL=
EXTERNAL_API_TOKEN=
EXTERNAL_API_TIMEOUT_MS=15000

# Segreto condiviso con devops per chiamare POST /api/devops/risultati
# (header "Authorization: Bearer <segreto>"). Generalo con: openssl rand -hex 32
DEVOPS_WEBHOOK_SECRET=
